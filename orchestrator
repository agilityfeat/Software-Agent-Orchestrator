#!/usr/bin/env python3
"""Private, local-only bootstrap. Never print credentials or run a model."""
import argparse
import hashlib
import json
import os
import platform
from pathlib import Path
import secrets
import shutil
import stat
import subprocess
import sys
import tempfile
import time

if sys.version_info < (3, 11):
    sys.exit('orchestrator requires Python 3.11 or newer.')

ROOT = Path(__file__).resolve().parent
CODEX_VERSION = '0.153.4'
BINS = ('workboard-rs', 'workboard-worker', 'workboard-publisher')

class SetupError(Exception):
    pass

def fail(message):
    raise SetupError(message)

def digest(path):
    with open(path, 'rb') as file:
        return hashlib.file_digest(file, 'sha256').hexdigest()

def linux_path(path):
    """WSL interop/Windows mounts cannot provide this starter's Unix boundary."""
    if sys.platform != 'linux':
        return
    path = Path(path).expanduser().absolute().resolve()
    if path == Path('/mnt') or Path('/mnt') in path.parents:
        fail('Use the Linux filesystem (for example ~/projects), not /mnt or Windows drives; see docs/windows.md.')
    # Also catch Windows drives mounted somewhere other than WSL's default /mnt.
    try:
        mounts = Path('/proc/self/mountinfo').read_text().splitlines()
    except OSError:
        fail('Cannot verify Linux mount boundaries; /proc/self/mountinfo must be available.')
    selected = (0, '')
    for line in mounts:
        fields = line.split()
        if len(fields) < 7 or '-' not in fields:
            continue
        sep = fields.index('-')
        if len(fields) <= sep + 1:
            continue
        mount = fields[4]
        for escaped, plain in ((r'\040', ' '), (r'\011', '\t'), (r'\012', '\n'), (r'\134', '\\')):
            mount = mount.replace(escaped, plain)
        point = Path(mount)
        if (path == point or point in path.parents) and len(point.parts) >= selected[0]:
            selected = (len(point.parts), fields[sep + 1])
    if selected[1] in ('drvfs', '9p', 'ntfs', 'ntfs3', 'fuseblk', 'vfat', 'exfat', 'cifs'):
        fail('Use a Linux-native filesystem for tools, source, state and credentials; see docs/windows.md.')

def local_path_env():
    paths = []
    for value in os.environ.get('PATH', '/usr/bin:/bin').split(os.pathsep):
        if not value or not Path(value).is_absolute():
            continue
        try:
            linux_path(value)
        except SetupError:
            continue
        paths.append(value)
    return os.pathsep.join(paths)

def executable_boundary(path):
    linux_path(path)
    if sys.platform == 'linux':
        with open(path, 'rb') as file:
            windows_binary = file.read(2) == b'MZ'
        if path.suffix.lower() == '.exe' or windows_binary:
            fail('Install Linux executables inside WSL; Windows .exe/PE tools are not supported. See docs/windows.md.')

def default_state():
    if sys.platform == 'darwin':
        return Path.home() / 'Library/Application Support/software-agent-orchestrator'
    return Path(os.environ.get('XDG_DATA_HOME', Path.home() / '.local/share')) / 'software-agent-orchestrator'

def canonical(path):
    path = Path(path).expanduser().absolute()
    linux_path(path)
    if '..' in path.parts:
        fail('Use an absolute path without parent traversal.')
    for part in (path, *path.parents):
        if part.is_symlink():
            fail('State and credential paths must not contain symlinks.')
    return path

def directory(path, private=True):
    meta = path.lstat()
    if not stat.S_ISDIR(meta.st_mode) or meta.st_uid != os.getuid() or (meta.st_mode & (0o077 if private else 0o022)):
        fail('Directory must be owned by you with safe permissions: ' + str(path))

def private_file(path):
    canonical(path)
    meta = path.lstat()
    if not stat.S_ISREG(meta.st_mode) or meta.st_uid != os.getuid() or meta.st_nlink != 1 or meta.st_mode & 0o077 or meta.st_size > 16384:
        fail('File must be a single owner-only regular file: ' + str(path))

def write(path, value):
    data = value if isinstance(value, bytes) else (json.dumps(value, sort_keys=True, separators=(',', ':')) + '\n').encode()
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'wb') as file:
        file.write(data)
        file.flush()
        os.fsync(file.fileno())

def tool(value, name):
    found = value or shutil.which(name, path=local_path_env())
    if not found:
        fail('Install ' + name + ' or pass --' + name + ' with its absolute executable path.')
    linux_path(found)
    path = Path(found).resolve(strict=True)
    meta = path.stat()
    if not path.is_file() or not os.access(path, os.X_OK) or meta.st_mode & 0o022:
        fail('Executable is missing or writable by other users: ' + name)
    executable_boundary(path)
    return path

def codex_native(value):
    path = tool(value, 'codex')
    with open(path, 'rb') as file:
        scripted = file.read(2) == b'#!'
    if not scripted:
        return path
    package = path.parent.parent
    metadata = package / 'package.json'
    try:
        data = json.loads(metadata.read_bytes())
    except (OSError, ValueError):
        fail('Pass --codex with the installed native Codex executable (not a script wrapper).')
    if path.name != 'codex.js' or path.parent.name != 'bin' or data.get('name') != '@openai/codex' or data.get('version') != CODEX_VERSION:
        fail('Unrecognized Codex wrapper. Install the supported version or pass --codex with its native executable.')
    arch = {'arm64': 'arm64', 'aarch64': 'arm64', 'x86_64': 'x64', 'amd64': 'x64'}.get(platform.machine().lower())
    target = {('darwin', 'arm64'): 'aarch64-apple-darwin', ('darwin', 'x64'): 'x86_64-apple-darwin', ('linux', 'arm64'): 'aarch64-unknown-linux-musl', ('linux', 'x64'): 'x86_64-unknown-linux-musl'}.get((sys.platform, arch))
    if not target:
        fail('Native bootstrap currently supports macOS/Linux x64/arm64 only.')
    suffix = ('darwin' if sys.platform == 'darwin' else 'linux') + '-' + arch
    optional = 'codex-' + suffix
    alias_version = CODEX_VERSION + '-' + suffix
    expected_alias = 'npm:@openai/codex@' + alias_version
    declared_alias = data.get('optionalDependencies', {}).get('@openai/' + optional)
    roots = [package / 'vendor']
    for candidate in (package / 'node_modules/@openai' / optional, package.parent / optional):
        try:
            dep = json.loads((candidate / 'package.json').read_bytes())
            # npm installs this optional dependency under an alias directory, but
            # its package identity/version remain @openai/codex@VERSION-PLATFORM.
            if declared_alias == expected_alias and dep.get('name') == '@openai/codex' and dep.get('version') == alias_version:
                roots.insert(0, candidate / 'vendor')
        except (OSError, ValueError):
            pass
    for root in roots:
        for tail in ('bin/codex', 'codex/codex'):
            binary = root / target / tail
            if binary.is_file():
                resolved = tool(binary, 'codex')
                with open(resolved, 'rb') as file:
                    if file.read(2) != b'#!':
                        return resolved
    fail('Native Codex package is missing. Reinstall @openai/codex@' + CODEX_VERSION + ' or pass --codex with its native executable.')

def clean_env(home=None):
    return {'PATH': local_path_env(), 'HOME': str(home or Path.home()), 'LANG': 'C.UTF-8'}

def quiet(argv, timeout=30):
    result = subprocess.run([str(x) for x in argv], env=clean_env(), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout)
    if result.returncode:
        fail('Prerequisite command failed: ' + Path(argv[0]).name + ' (no credential output retained).')
    return result.stdout

def authentication(codex_home, gh):
    directory(codex_home)
    auth = codex_home / 'auth.json'
    try:
        private_file(auth)
    except (SetupError, FileNotFoundError):
        fail('Sign in with codex login; auth.json must be owner-only. If needed: chmod 600 ' + str(auth))
    value = json.loads(auth.read_bytes())
    if not isinstance(value.get('tokens', {}).get('account_id'), str):
        fail('Use your own ChatGPT Codex login (codex login); this starter expects account-based authentication.')
    quiet([gh, 'auth', 'status', '--hostname', 'github.com'])

def program(path, env=(), actual=None):
    return {'executable': str(path), 'sha256': digest(actual or path), 'credential_env_names': list(env)}

def safe_read_roots(values, state, auth):
    result = []
    for value in values:
        path = canonical(value)
        if not path.is_dir() or path in (Path('/'), Path.home()) or path.is_relative_to(auth) or auth.is_relative_to(path) or path.is_relative_to(state) or state.is_relative_to(path):
            fail('Read roots must be existing narrow toolchain directories, outside private state and credentials.')
        if any(part in ('.ssh', '.aws', '.codex', '.config', 'secrets') for part in path.parts):
            fail('Credential directories cannot be agent read roots.')
        result.append(str(path))
    return sorted(set(result))

def manifest(state):
    directory(state)
    path = state / 'bootstrap.json'
    private_file(path)
    data = json.loads(path.read_bytes())
    if data.get('schema_version') != 1:
        fail('Unknown bootstrap format; do not overwrite this state.')
    return data

def verify(state):
    data = manifest(state)
    for name in ('state', 'secrets', 'bin', 'actions', 'workspaces'):
        directory(canonical(state / name))
    for name in ('setup.json', 'launch.json'):
        file = state / 'state' / name
        private_file(file)
        if digest(file) != data['files'][name]:
            fail('Saved setup changed. Refusing to repin or overwrite it.')
    for name in ('codex_home', 'projects_root'):
        linux_path(data['inputs'][name])
    for root in data['inputs']['read_roots']:
        linux_path(root)
    launch = json.loads((state / 'state/launch.json').read_bytes())
    for name in ('operator_key_file', 'setup_key_file'):
        private_file(Path(launch[name]))
    setup = json.loads((state / 'state/setup.json').read_bytes())
    if setup['runtime']['expires_at_ms'] <= int(time.time() * 1000):
        fail('Setup has expired. Stop and preserve this state; prepare a separately reviewed renewal before continuing.')
    for path, expected in data['programs'].items():
        file = Path(path)
        linux_path(file)
        executable_boundary(file)
        if file.is_symlink() or digest(file) != expected:
            fail('A pinned program changed. Refusing automatic updates; stop and review a new setup.')
    return data, launch

def init(args):
    state = canonical(args.state_dir)
    if state == ROOT or state.is_relative_to(ROOT):
        fail('Private state must be outside the source checkout.')
    auth = canonical(args.codex_home or os.environ.get('CODEX_HOME', Path.home() / '.codex'))
    codex, gh, git = codex_native(args.codex), tool(args.gh, 'gh'), tool(args.git, 'git')
    version = quiet([codex, '--version']).decode().strip()
    if version != 'codex-cli ' + CODEX_VERSION:
        fail('This release requires Codex CLI ' + CODEX_VERSION + '; received an untested version.')
    # Native CLI must be pinned, not a mutable npm/shebang launcher with hidden dependencies.
    with open(codex, 'rb') as file:
        if file.read(2) == b'#!':
            fail('Pass --codex pointing to the installed native Codex binary, not a script launcher.')
    projects = canonical(args.projects_root or state / 'projects')
    if projects == ROOT or projects.is_relative_to(ROOT):
        fail('Managed projects must be outside the source checkout.')
    if state.is_relative_to(auth) or auth.is_relative_to(state):
        fail('Private state and existing Codex credential home must be separate directories.')
    defaults = [x for x in ('/opt/homebrew', '/Library/Developer/CommandLineTools') if Path(x).is_dir()]
    roots = safe_read_roots(args.read_root if args.read_root is not None else defaults, state, auth)
    inputs = {'codex_home': str(auth), 'codex': str(codex), 'gh': str(gh), 'git': str(git), 'projects_root': str(projects), 'read_roots': roots, 'port': args.port}
    if state.exists():
        data, _ = verify(state)
        if data['inputs'] != inputs:
            fail('Already initialized with different settings. Existing state will not be overwritten.')
        print('Already initialized; saved keys and pins preserved: ' + str(state))
        return
    parent = state.parent
    parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    for ancestor in (parent, *parent.parents):
        meta = ancestor.stat()
        if meta.st_mode & 0o022 and not (meta.st_mode & stat.S_ISVTX):
            fail('State parent is writable by other users: ' + str(ancestor))
    authentication(auth, gh)
    staging = Path(tempfile.mkdtemp(prefix='.orchestrator-init-', dir=parent))
    try:
        for name in ('bin', 'state', 'secrets', 'actions', 'actions/planning', 'workspaces', 'workspaces/planning', 'projects'):
            (staging / name).mkdir(mode=0o700)
        if args.binary_dir:
            build = canonical(args.binary_dir)
        else:
            cargo_launcher = args.cargo or shutil.which('cargo', path=local_path_env())
            tool(cargo_launcher, 'cargo')  # Validate target, but preserve rustup's argv[0] dispatch.
            cargo = Path(cargo_launcher).expanduser().absolute()
            env = clean_env()
            for name in ('CARGO_HOME', 'RUSTUP_HOME'):
                if name in os.environ:
                    linux_path(os.environ[name])
                    env[name] = os.environ[name]
            env['CARGO_TARGET_DIR'] = str(staging / 'build')
            command = [str(cargo), 'build', '--locked', '--release']
            for name in BINS:
                command.extend(['--bin', name])
            result = subprocess.run(command, cwd=ROOT, env=env, stdin=subprocess.DEVNULL)
            if result.returncode:
                fail('Cargo build failed; no state was installed. Fix the build and run init again.')
            build = staging / 'build/release'
        for name in BINS:
            source = build / name
            if source.is_symlink() or not source.is_file() or not os.access(source, os.X_OK):
                fail('Missing release executable: ' + name)
            executable_boundary(source)
            shutil.copyfile(source, staging / 'bin' / name)
            (staging / 'bin' / name).chmod(0o700)
        if not projects.is_relative_to(state):
            projects.mkdir(parents=True, exist_ok=True, mode=0o700)
            directory(projects, private=False)
        if projects.is_relative_to(state):
            relative = projects.relative_to(state)
            if not relative.parts or relative.parts[0] != 'projects':
                fail('An internal projects root must be under the dedicated projects directory.')
            (staging / relative).mkdir(parents=True, exist_ok=True, mode=0o700)
        for name in ('operator.key', 'setup.key'):
            write(staging / 'secrets' / name, secrets.token_urlsafe(48).encode())
        write(staging / 'state/workspace-catalog.json', {'schema_version': 1, 'workspaces': []})
        native = {'native_planning': True, 'codex': program(codex), 'projects_root': str(projects), 'catalog_path': str(state / 'state/workspace-catalog.json'), 'path': inputs_path(codex, gh, git), 'read_roots': roots, 'agents': [{'id': 'coder', 'label': 'Coder', 'instructions': 'Implement the task, execute relevant checks and inspect the whole diff.'}, {'id': 'qa', 'label': 'QA', 'instructions': 'Independently verify the exact implementation and task-related regressions.'}], 'default_coder': 'coder', 'qa_agent': 'qa'}
        adapter = {'repository': 'setup/placeholder', 'state_root': str(state / 'actions'), 'auth_home': str(auth), 'docker': program(git), 'git': program(git), 'gh': program(gh), 'docker_host': 'unused', 'worker_image': 'unused', 'worker_network': 'unused', 'proxy_container': 'unused', 'proxy_image': 'unused', 'proxy_ip': 'unused', 'proxy_port': 0, 'proxy_policy_sha256': 'unused', 'proxy_allowed_hosts': [], 'model': None, 'cpus': 2, 'memory_mb': 1024, 'native_agent': native}
        runtime = {'schema_version': 1, 'containment_contract': 'reviewed-launcher-v1', 'expires_at_ms': int((time.time() + 365 * 86400) * 1000), 'work_root': str(state / 'workspaces'), 'worker': program(state / 'bin/workboard-worker', ('CODEX_HOME',), staging / 'bin/workboard-worker'), 'publisher': program(state / 'bin/workboard-publisher', ('GH_TOKEN',), staging / 'bin/workboard-publisher'), 'git': program(git), 'max_run_seconds': 14400, 'max_stage_seconds': 3600, 'max_output_bytes': 1048576, 'max_qa_repairs': 2, 'adapter_policy': adapter}
        write(staging / 'state/setup.json', {'schema_version': 1, 'runtime': runtime, 'max_runs_per_project': 10000, 'planning_enabled': True})
        launch = {'schema_version': 1, 'database_path': str(state / 'state/workboard.sqlite'), 'port': args.port, 'operator_key_file': str(state / 'secrets/operator.key'), 'setup_file': str(state / 'state/setup.json'), 'setup_sha256': digest(staging / 'state/setup.json'), 'setup_key_file': str(state / 'secrets/setup.key'), 'provider_home': str(auth), 'github_token_env': 'GH_TOKEN'}
        write(staging / 'state/launch.json', launch)
        pins = {str(path): digest(path) for path in (codex, gh, git)}
        pins.update({str(state / 'bin' / name): digest(staging / 'bin' / name) for name in BINS})
        write(staging / 'bootstrap.json', {'schema_version': 1, 'inputs': inputs, 'files': {name: digest(staging / 'state' / name) for name in ('setup.json', 'launch.json')}, 'programs': pins})
        os.rename(staging, state)
        print('Initialized paused local app: ' + str(state))
        print('Start: ./orchestrator start; view key privately: ./orchestrator key')
    finally:
        if staging.exists():
            shutil.rmtree(staging)

def inputs_path(*tools):
    return ':'.join(dict.fromkeys([str(p.parent) for p in tools] + [p for p in ['/opt/homebrew/bin', '/usr/local/bin', '/usr/bin', '/bin', '/usr/sbin', '/sbin'] if Path(p).is_dir()]))

def main():
    if sys.platform == 'win32':
        fail('Native Windows is not supported. Open Ubuntu in WSL2 and follow docs/windows.md; do not run this with Windows Python.')
    linux_path(ROOT)
    linux_path(sys.executable)
    linux_path(Path.home())
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    for command in ('init', 'start', 'doctor', 'key'):
        sub = commands.add_parser(command)
        sub.add_argument('--state-dir', type=Path, default=default_state())
        if command == 'init':
            for name in ('codex-home', 'projects-root', 'binary-dir', 'codex', 'gh', 'git', 'cargo'):
                sub.add_argument('--' + name, type=Path)
            sub.add_argument('--read-root', type=Path, action='append')
            sub.add_argument('--port', type=int, default=4311)
    args = parser.parse_args()
    if args.command == 'init':
        if not 1 <= args.port <= 65535 or args.port == 4310:
            fail('Choose a valid local port other than reserved port 4310.')
        init(args)
        return
    state = canonical(args.state_dir)
    data, launch = verify(state)
    if args.command == 'key':
        if not sys.stdout.isatty():
            fail('The operator key is shown only in an interactive terminal. Never paste it into logs.')
        print(Path(launch['operator_key_file']).read_text())
    elif args.command == 'doctor':
        authentication(Path(data['inputs']['codex_home']), Path(data['inputs']['gh']))
        print('Pins, private state, Codex ' + CODEX_VERSION + ', own-account login references: OK')
        print('Main planning: native read-only; no inference was run. URL: http://127.0.0.1:' + str(launch['port']))
    else:
        os.execve(str(state / 'bin/workboard-rs'), [str(state / 'bin/workboard-rs'), 'dev', str(state / 'state/launch.json')], clean_env())

if __name__ == '__main__':
    try:
        main()
    except (SetupError, OSError, ValueError, subprocess.TimeoutExpired) as error:
        print('orchestrator: ' + (str(error) if isinstance(error, SetupError) else type(error).__name__ + '; check paths and prerequisites.'), file=sys.stderr)
        sys.exit(1)
