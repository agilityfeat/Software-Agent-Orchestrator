# Fixed internal credential-free dependency preparation. WORKER_IMAGE is a local
# tag checked against the approved immutable image before and after the build.
ARG WORKER_IMAGE
FROM ${WORKER_IMAGE}
USER root
RUN rm -rf /opt/workboard-node-profile /opt/workboard-node-cache && mkdir /opt/workboard-node-profile
WORKDIR /opt/workboard-node-profile
COPY package.json package-lock.json ./
COPY prepare-cache.mjs ./prepare-cache.mjs
RUN touch empty.npmrc && npm ci --ignore-scripts --no-audit --no-fund --registry=https://registry.npmjs.org --userconfig=/opt/workboard-node-profile/empty.npmrc --globalconfig=/dev/null --cache /opt/workboard-node-cache \
    && node prepare-cache.mjs \
    && rm -rf node_modules prepare-cache.mjs \
    && chmod -R a+rX,a-w /opt/workboard-node-cache /opt/workboard-node-profile
USER 65532:65532
WORKDIR /tmp
